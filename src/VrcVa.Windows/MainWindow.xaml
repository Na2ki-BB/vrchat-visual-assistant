<Window x:Class="VrcVa.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRChat Visual Assistant"
        Width="780"
        Height="900"
        MinWidth="620"
        MinHeight="560"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="Manual">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="VRChat Visual Assistant" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{StaticResource TextSecondary}"
                 FontSize="14"
                 Text="見えている英語を、1回のSCANで日本語へ" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,16,0,0"
            Padding="12"
            Background="#13232A"
            BorderBrush="#28596B"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="プライバシー境界" />
        <TextBlock x:Name="PrivacyText"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Margin="0,12,0,0"
            Padding="12"
            Background="#1C252B"
            BorderBrush="#3B4850"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel>
        <TextBlock x:Name="OcrLanguageStatusText"
                   FontWeight="SemiBold"
                   Text="使用するOCR認識器: 確認中 / 利用可能: 確認中" />
        <Border x:Name="OcrLanguageWarningBorder"
                Margin="0,9,0,0"
                Padding="10"
                Background="#3A1919"
                BorderBrush="#E26666"
                BorderThickness="2"
                CornerRadius="5"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock FontSize="16"
                       FontWeight="Bold"
                       Foreground="#FF9B9B"
                       Text="英語OCRが未導入です" />
            <TextBlock x:Name="OcrLanguageWarningText"
                       Margin="0,5,0,0"
                       Foreground="#FFE2E2"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Padding="12"
            Background="#1C252B"
            BorderBrush="#3B4850"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="翻訳モデル" />
          <ComboBox x:Name="TranslationModelComboBox"
                    Grid.Column="1"
                    Width="260"
                    MinHeight="40"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="TranslationModelComboBox_SelectionChanged" />
          <TextBlock x:Name="TranslationModelHintText"
                     Grid.Column="2"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondary}"
                     Text="次回のSCANから反映" />
        </Grid>
        <Grid Margin="0,9,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Margin="0,0,12,0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="OpenAI APIキー" />
          <PasswordBox x:Name="OpenAiApiKeyPasswordBox"
                       Grid.Column="1"
                       MinWidth="180"
                       MinHeight="36"
                       VerticalContentAlignment="Center" />
          <Button Grid.Column="2"
                  Margin="8,0,0,0"
                  Click="SaveOpenAiApiKeyButton_Click"
                  Content="暗号化して保存" />
          <Button Grid.Column="3"
                  Margin="8,0,0,0"
                  Click="DeleteOpenAiApiKeyButton_Click"
                  Content="削除" />
        </Grid>
        <TextBlock x:Name="OpenAiApiKeyStatusText"
                   Margin="0,6,0,0"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12"
            Background="#1C252B"
            BorderBrush="#3B4850"
            BorderThickness="1"
            CornerRadius="6">
      <Expander x:Name="PlacementSettingsExpander"
                Header="VR結果パネルの配置"
                IsExpanded="False">
        <StackPanel Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="追従先" />
            <ComboBox x:Name="ResultPanelAnchorComboBox"
                      Grid.Column="1"
                      MinHeight="34"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ResultPanelAnchorComboBox_SelectionChanged" />
            <TextBlock Grid.Column="2"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       Text="変更はプレビューへ即時反映" />
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock FontWeight="SemiBold" Text="位置（メートル）" />
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="X" />
                <Slider x:Name="ResultPanelXSlider" Grid.Column="1"
                        Minimum="-1.5" Maximum="1.5" SmallChange="0.01"
                        ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ElementName=ResultPanelXSlider, Path=Value, StringFormat={}{0:0.00}}" />
              </Grid>
              <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Y" />
                <Slider x:Name="ResultPanelYSlider" Grid.Column="1"
                        Minimum="-1.5" Maximum="1.5" SmallChange="0.01"
                        ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ElementName=ResultPanelYSlider, Path=Value, StringFormat={}{0:0.00}}" />
              </Grid>
              <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Z" />
                <Slider x:Name="ResultPanelZSlider" Grid.Column="1"
                        Minimum="-1.5" Maximum="1.5" SmallChange="0.01"
                        ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ElementName=ResultPanelZSlider, Path=Value, StringFormat={}{0:0.00}}" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock FontWeight="SemiBold" Text="角度（度）" />
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="上下" />
                <Slider x:Name="ResultPanelPitchSlider" Grid.Column="1"
                        Minimum="-180" Maximum="180" SmallChange="1"
                        ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ElementName=ResultPanelPitchSlider, Path=Value, StringFormat={}{0:0}}" />
              </Grid>
              <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="左右" />
                <Slider x:Name="ResultPanelYawSlider" Grid.Column="1"
                        Minimum="-180" Maximum="180" SmallChange="1"
                        ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ElementName=ResultPanelYawSlider, Path=Value, StringFormat={}{0:0}}" />
              </Grid>
              <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="傾き" />
                <Slider x:Name="ResultPanelRollSlider" Grid.Column="1"
                        Minimum="-180" Maximum="180" SmallChange="1"
                        ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ElementName=ResultPanelRollSlider, Path=Value, StringFormat={}{0:0}}" />
              </Grid>
            </StackPanel>
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="55" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="横幅" />
            <Slider x:Name="ResultPanelWidthSlider" Grid.Column="1"
                    Minimum="0.25" Maximum="1.5" SmallChange="0.01"
                    ValueChanged="ResultPanelPlacementSlider_ValueChanged" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                       Text="{Binding ElementName=ResultPanelWidthSlider, Path=Value, StringFormat={}{0:0.00}}" />
            <Button Grid.Column="4" Click="PreviewResultPanelPlacementButton_Click" Content="プレビュー" />
            <Button Grid.Column="5" Margin="8,0,0,0" Click="ResetResultPanelPlacementButton_Click" Content="初期値" />
            <Button Grid.Column="6" Margin="8,0,0,0" Click="SaveResultPanelPlacementButton_Click" Content="保存" />
          </Grid>
          <TextBlock x:Name="ResultPanelPlacementStatusText"
                     Margin="0,7,0,0"
                     Foreground="{StaticResource TextSecondary}"
                     TextWrapping="Wrap"
                     Text="調整後に保存すると、次回から同じ配置を使います。" />
        </StackPanel>
      </Expander>
    </Border>

    <Grid Grid.Row="5" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="ScanButton"
              Grid.Column="0"
              Background="#16739A"
              Foreground="White"
              FontWeight="Bold"
              Click="ScanButton_Click"
              Content="SCAN  (Ctrl+Shift+T)" />
      <Button x:Name="ImageButton"
              Grid.Column="1"
              Click="ImageButton_Click"
              Content="画像で診断" />
      <Button x:Name="CancelButton"
              Grid.Column="2"
              IsEnabled="False"
              Click="CancelButton_Click"
              Content="キャンセル" />
      <CheckBox Grid.Column="4"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextSecondary}"
                Checked="TopmostCheckBox_Changed"
                Unchecked="TopmostCheckBox_Changed"
                Content="常に手前" />
    </Grid>

    <GroupBox Grid.Row="6"
              Margin="0,0,0,12"
              Padding="10"
              Foreground="{StaticResource TextSecondary}"
              Header="OCR結果（英語）">
      <TextBox x:Name="SourceTextBox"
               AcceptsReturn="True"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
    </GroupBox>

    <GroupBox Grid.Row="7"
              Padding="10"
              Foreground="{StaticResource TextSecondary}"
              Header="日本語訳">
      <TextBox x:Name="TranslationTextBox"
               AcceptsReturn="True"
               IsReadOnly="True"
               FontSize="19"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
    </GroupBox>

    <Grid Grid.Row="8" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock x:Name="StatusText"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Text="起動中…" />
        <TextBlock x:Name="DetailText"
                   Margin="0,3,0,0"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1"
              Margin="12,0,0,0"
              Click="CopyButton_Click"
              Content="日本語訳をコピー" />
    </Grid>
  </Grid>
</Window>
