<Window x:Class="VrcVa.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRChat Visual Assistant"
        Width="780"
        Height="720"
        MinWidth="620"
        MinHeight="580"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="VRChat Visual Assistant" />
      <TextBlock Margin="0,5,0,0"
                 Foreground="{StaticResource TextSecondary}"
                 FontSize="14"
                 Text="見えている英語を、1回のSCANで日本語へ" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,16,0,0"
            Padding="12"
            Background="#13232A"
            BorderBrush="#28596B"
            BorderThickness="1"
            CornerRadius="6">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="プライバシー境界" />
        <TextBlock x:Name="PrivacyText"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button x:Name="ScanButton"
              Grid.Column="0"
              Background="#16739A"
              Foreground="White"
              FontWeight="Bold"
              Click="ScanButton_Click"
              Content="SCAN  (Ctrl+Shift+T)" />
      <Button x:Name="ImageButton"
              Grid.Column="1"
              Click="ImageButton_Click"
              Content="画像で診断" />
      <Button x:Name="CancelButton"
              Grid.Column="2"
              IsEnabled="False"
              Click="CancelButton_Click"
              Content="キャンセル" />
      <CheckBox Grid.Column="4"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextSecondary}"
                Checked="TopmostCheckBox_Changed"
                Unchecked="TopmostCheckBox_Changed"
                Content="常に手前" />
    </Grid>

    <GroupBox Grid.Row="3"
              Margin="0,0,0,12"
              Padding="10"
              Foreground="{StaticResource TextSecondary}"
              Header="OCR結果（英語）">
      <TextBox x:Name="SourceTextBox"
               AcceptsReturn="True"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
    </GroupBox>

    <GroupBox Grid.Row="4"
              Padding="10"
              Foreground="{StaticResource TextSecondary}"
              Header="日本語訳">
      <TextBox x:Name="TranslationTextBox"
               AcceptsReturn="True"
               IsReadOnly="True"
               FontSize="19"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
    </GroupBox>

    <Grid Grid.Row="5" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock x:Name="StatusText"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Text="起動中…" />
        <TextBlock x:Name="DetailText"
                   Margin="0,3,0,0"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1"
              Margin="12,0,0,0"
              Click="CopyButton_Click"
              Content="日本語訳をコピー" />
    </Grid>
  </Grid>
</Window>

