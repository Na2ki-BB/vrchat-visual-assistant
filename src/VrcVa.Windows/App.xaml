<Application x:Class="VrcVa.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#111318" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1A1E25" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F4F8" />
    <SolidColorBrush x:Key="TextSecondary" Color="#AAB2C0" />
    <SolidColorBrush x:Key="Accent" Color="#61D0FF" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0D0F13" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="#353C48" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="FontSize" Value="16" />
    </Style>
  </Application.Resources>
</Application>
