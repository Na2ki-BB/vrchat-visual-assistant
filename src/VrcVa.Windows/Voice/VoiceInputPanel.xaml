<UserControl x:Class="VrcVa.Windows.Voice.VoiceInputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111318" Foreground="#F2F4F8">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20">
      <TextBlock Text="共通音声入力" FontSize="26" FontWeight="SemiBold" Foreground="#F2F4F8" />
      <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#AAB2C0"
                 Text="Windowsの既定の通信マイクで録音します。VRやVRChatを起動せずに使えます。常時録音はしません。" />
      <Border Margin="0,14,0,0" Padding="12" Background="#13232A" BorderBrush="#28596B" BorderThickness="1" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="有効化の前に確認してください" FontWeight="Bold" Foreground="#61D0FF" />
          <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#F2F4F8"
                     Text="録音を停止すると、録音した音声全体をOpenAIの音声API（api.openai.com / gpt-transcribe）へ送信します。周囲の人の声が入る可能性があります。周囲の了解と録音内容を確認してください。VRChat内ミュートは、OS・物理マイクのミュートとは別です。" />
          <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#F2F4F8"
                     Text="有料APIです。送信開始後の失敗・中止も利用枠を消費し、再試行は追加の送信です。サービス側の処理・課金の取消は保証できません。アプリの枠は起動ごとの制限で、月額予算の保証ではありません。" />
          <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#AAB2C0"
                     Text="参考料金: gpt-transcribeは音声1分あたり約US$0.0045（2026-10-01確認）。価格は変わるため、利用前に公式料金を確認してください。" />
          <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#AAB2C0"
                     Text="音声と認識文はアプリ内のメモリだけで扱い、ファイル・設定・ログへ保存しません。成功した音声は破棄し、失敗音声のみ期限内に手動再試行できます。中止・閉じる・録り直し・終了で破棄します。API側の保持条件は下記の公式説明を確認してください。Responses APIのstore:falseは音声には適用しません。" />
          <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#AAB2C0">
            <Hyperlink NavigateUri="https://developers.openai.com/api/docs/pricing" RequestNavigate="PolicyLink_RequestNavigate">OpenAI公式料金</Hyperlink>
            <Run Text="  /  " />
            <Hyperlink NavigateUri="https://developers.openai.com/api/docs/guides/your-data" RequestNavigate="PolicyLink_RequestNavigate">データ保持条件</Hyperlink>
          </TextBlock>
          <CheckBox x:Name="ConsentCheckBox" Margin="0,14,0,0" Foreground="#F2F4F8"
                    Click="ConsentCheckBox_Click" Content="上記を確認し、録音操作による音声の外部送信を有効にする" />
        </StackPanel>
      </Border>
      <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Foreground="#F2F4F8" Text="音声専用 OpenAI APIキー（翻訳用とは別保存）" />
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <PasswordBox x:Name="VoiceKeyBox" Grid.Column="0" MinHeight="36" VerticalContentAlignment="Center" />
        <Button x:Name="SaveKeyButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,8" Click="SaveKeyButton_Click" Content="専用キーを保存" />
        <Button x:Name="DeleteKeyButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,8" Click="DeleteKeyButton_Click" Content="削除" />
      </Grid>
      <TextBlock x:Name="ConfigurationStatusText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#AAB2C0"
                 Text="保存先: Windows資格情報マネージャー VrcVa/OpenAI/Voice。キーの保存だけでは音声入力は有効になりません。" />
      <TextBlock x:Name="QuotaText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#AAB2C0" />
      <WrapPanel Margin="0,16,0,0">
        <Button x:Name="RecordButton" Padding="14,10" Margin="0,0,8,8" Click="RecordButton_Click" Content="録音開始" />
        <Button x:Name="CancelVoiceButton" Padding="14,10" Margin="0,0,8,8" Click="CancelVoiceButton_Click" Content="中止" />
        <Button x:Name="RetryButton" Padding="14,10" Margin="0,0,8,8" Click="RetryButton_Click" Content="保持した音声を再送" />
        <Button x:Name="CloseVoiceButton" Padding="14,10" Margin="0,0,8,8" Click="CloseVoiceButton_Click" Content="閉じる・内容を破棄" />
      </WrapPanel>
      <TextBlock x:Name="FlowStatusText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="16" Foreground="#61D0FF" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="FlowDetailText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#AAB2C0" />
      <TextBlock Margin="0,16,0,6" Text="認識した文章（全文）" FontWeight="SemiBold" Foreground="#F2F4F8" />
      <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="360"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#0D0F13"
               Foreground="#F2F4F8" BorderBrush="#353C48" Padding="10" FontSize="16" />
      <ContentControl x:Name="ResultActionsHost" Margin="0,10,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
